<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= appName %></title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar">

        <div class="logo">
            🎵 <%= appName %>
        </div>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/songs">Songs</a>
        </div>

    </nav>


    <!-- Hero Section -->
    <section class="hero">

        <div class="hero-content">

            <div class="music-icon">
                🎧
            </div>

            <h1>
                Welcome to <%= appName %>
            </h1>

            <p>
                <%= tagline %>
            </p>

            <a href="/songs" class="btn">
                Explore Songs 🎵
            </a>

        </div>

    </section>


    <!-- Features -->
    <section class="features">

        <h2>Why SoundWave?</h2>

        <div class="feature-container">

            <div class="feature-card">
                <div class="feature-icon">🎶</div>
                <h3>Great Music</h3>
                <p>
                    Explore a collection of amazing songs from different artists.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🎤</div>
                <h3>Popular Artists</h3>
                <p>
                    Discover music from popular artists and performers.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🎧</div>
                <h3>Different Genres</h3>
                <p>
                    Enjoy Pop, Rock, Electronic, Romantic and many more genres.
                </p>
            </div>

        </div>

    </section>


    <!-- Footer -->
    <footer>
        <p>© 2026 <%= appName %>. All Rights Reserved.</p>
    </footer>

</body>
</html>